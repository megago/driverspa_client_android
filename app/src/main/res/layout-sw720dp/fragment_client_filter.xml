<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp">

            <!-- ===================== Header ===================== -->
            <FrameLayout
                android:id="@+id/title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/action_bar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:text="Фильтры"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_large"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|right"
                    android:background="@drawable/background_filter_card"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close_white_24dp" />
            </FrameLayout>

            <!-- ================ Location & sorting card ================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/background_filter_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cityLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/background_filter_card"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_city_white" />

                    <TextView
                        android:id="@+id/txtCity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Астана"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ImageView
                        android:id="@+id/imageView6"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:alpha="0.7"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="70dp"
                    android:background="@drawable/background_filter_divider_inset" />

                <LinearLayout
                    android:id="@+id/sortingLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="18dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sorting_white" />

                    <com.driverspa.view.NDSpinner
                        android:id="@+id/spinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:drawSelectorOnTop="true"
                        android:popupBackground="@color/background_main"
                        android:spinnerMode="dropdown"
                        android:textColor="@drawable/button_state_color"
                        android:textCursorDrawable="@null"
                        android:textSize="@dimen/text_medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================ Amenities section ================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="14dp"
                android:layout_marginLeft="8dp"
                android:letterSpacing="0.08"
                android:text="УДОБСТВА"
                android:textColor="@color/BlueLight"
                android:textSize="@dimen/text_normal"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_filter_card"
                android:orientation="vertical">

                <!-- Кафе -->
                <LinearLayout
                    android:id="@+id/cafeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cafe_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Кафе"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ToggleButton
                        android:id="@+id/toggle_cafe"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_switch_modern"
                        android:button="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="70dp"
                    android:background="@drawable/background_filter_divider_inset" />

                <!-- Кофе -->
                <LinearLayout
                    android:id="@+id/coffeeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coffee_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Кофе"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ToggleButton
                        android:id="@+id/toggle_coffee"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_switch_modern"
                        android:button="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="70dp"
                    android:background="@drawable/background_filter_divider_inset" />

                <!-- Wi-Fi -->
                <LinearLayout
                    android:id="@+id/wifiLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_wifi_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Wi-Fi"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ToggleButton
                        android:id="@+id/toggle_wifi"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_switch_modern"
                        android:button="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="70dp"
                    android:background="@drawable/background_filter_divider_inset" />

                <!-- Зона отдыха -->
                <LinearLayout
                    android:id="@+id/roomLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_restroom_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Зона отдыха"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ToggleButton
                        android:id="@+id/toggle_room"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_switch_modern"
                        android:button="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="70dp"
                    android:background="@drawable/background_filter_divider_inset" />

                <!-- Игровые приставки -->
                <LinearLayout
                    android:id="@+id/gameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_playstation_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Игровые приставки"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ToggleButton
                        android:id="@+id/toggle_games"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_switch_modern"
                        android:button="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="70dp"
                    android:background="@drawable/background_filter_divider_inset" />

                <!-- Оплата по карте -->
                <LinearLayout
                    android:id="@+id/nocashLayout"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cardpayment_white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:text="Оплата по карте"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium" />

                    <ToggleButton
                        android:id="@+id/toggle_nocash"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_switch_modern"
                        android:button="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== Apply ===================== -->
            <Button
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/background_filter_apply"
                android:text="ПРИМЕНИТЬ"
                android:textColor="@color/background_main"
                android:textSize="@dimen/text_medium"
                android:textStyle="bold" />

            <!-- =================================================================
                 Hidden filters retained so ButterKnife bindings stay valid.
                 ================================================================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 км"
                    android:textColor="@color/White" />

                <SeekBar
                    android:id="@+id/seek_distance"
                    style="@style/SeekBarAppTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1000"
                    android:textColor="@color/White" />

                <ImageView
                    android:id="@+id/minus_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_remove_circle_outline_white_18dp" />

                <ImageView
                    android:id="@+id/plus_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_add_circle_outline_white_18dp" />

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/background_image_star_small" />

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/background_image_star_small" />

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/background_image_star_small" />

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/background_image_star_small" />

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/background_image_star_small" />

                <ToggleButton
                    android:id="@+id/toggle_atm"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@null"
                    android:button="@null"
                    android:textOff=""
                    android:textOn="" />

                <LinearLayout
                    android:id="@+id/campaignLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ToggleButton
                        android:id="@+id/toggle_campaign"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@null"
                        android:button="@null"
                        android:textOff=""
                        android:textOn="" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
