<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--<androidx.coordinatorlayout.widget.CoordinatorLayout-->
        <!--android:id="@+id/coordinator"-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="match_parent">-->

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <include
                android:id="@+id/toolbar_actionbar"
                layout="@layout/toolbar_client_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/transparent" />
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.driverspa.view.CustomViewPager
                        android:id="@+id/pager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <!-- android:background="@drawable/background_menu_buttons" -->
                </LinearLayout>
            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/requestWindow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:visibility="gone">

                <RelativeLayout
                    android:id="@+id/mainLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="@dimen/vertical_margin_half"
                    android:layout_marginRight="@dimen/vertical_margin_half">

                    <ImageView
                        android:id="@+id/btnExpand2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="-15dp"
                        android:src="@drawable/ic_expand"
                        android:visibility="invisible" />

                    <LinearLayout
                        android:id="@+id/testLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/btnExpand2"
                        android:animateLayoutChanges="true"
                        android:background="@drawable/rounded_half_rectangle_white"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:paddingRight="@dimen/horizontal_margin_half"
                        android:paddingTop="@dimen/horizontal_margin"
                        android:paddingBottom="@dimen/horizontal_margin">


                        <LinearLayout
                            android:id="@+id/washerWindow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/price"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/from_500"
                                    android:textColor="@color/Black"
                                    android:textSize="@dimen/text_small" />

                                <FrameLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:id="@+id/layoutTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="left"
                                        android:orientation="horizontal">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_time_table_blue" />

                                        <TextView
                                            android:id="@+id/txtWasherTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                                            android:clickable="true"
                                            android:text="@string/around_clock"
                                            android:textColor="@color/Black"
                                            android:textColorLink="@color/White"
                                            android:textSize="@dimen/text_small" />
                                    </LinearLayout>
                                </FrameLayout>
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/vertical_margin_half"
                                android:background="@color/LightGrey" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/vertical_margin_third"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <RatingBar
                                        android:id="@+id/review"
                                        android:layout_width="wrap_content"
                                        android:layout_height="12dp"
                                        android:layout_gravity="center|left"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:isIndicator="true"
                                        android:numStars="5"
                                        android:progressDrawable="@drawable/custom_ratingbar_map_selector"
                                        android:rating="3.0"
                                        android:stepSize="0.2" />

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginRight="@dimen/horizontal_margin_half">

                                        <ImageView
                                            android:id="@+id/imgAvailability"
                                            android:layout_width="70dp"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center|right"
                                            android:layout_marginRight="@dimen/horizontal_margin"
                                            android:src="@drawable/ic_flag_online_list"
                                            android:visibility="visible" />
                                    </FrameLayout>
                                </FrameLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/washerDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/background_list_item_white"
                                android:orientation="horizontal">

                                <RelativeLayout
                                    android:id="@+id/washerLayout"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/vertical_margin_half"
                                    android:layout_weight="1">

                                    <ImageView
                                        android:id="@+id/imgWasherAvatar"
                                        android:layout_width="70dp"
                                        android:layout_height="50dp"
                                        android:layout_alignParentLeft="true"
                                        android:layout_marginRight="@dimen/horizontal_margin_half"
                                        android:clickable="true"
                                        android:scaleType="centerCrop" />

                                    <TextView
                                        android:id="@+id/txtWasherNameTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_toRightOf="@+id/imgWasherAvatar"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text=""
                                        android:textColor="@color/Black"
                                        android:textSize="@dimen/text_small" />

                                    <TextView
                                        android:id="@+id/txtWasherCity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/txtWasherNameTitle"
                                        android:layout_toRightOf="@+id/imgWasherAvatar"
                                        android:ellipsize="end"
                                        android:gravity="top|left"
                                        android:maxLines="1"
                                        android:text=""
                                        android:textColor="@color/DarkGray"
                                        android:textSize="@dimen/text_small" />

                                    <TextView
                                        android:id="@+id/txtWasherComment"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/txtWasherCity"
                                        android:layout_toRightOf="@+id/imgWasherAvatar"
                                        android:ellipsize="end"
                                        android:gravity="top|left"
                                        android:maxLines="2"
                                        android:text=""
                                        android:textColor="@color/DarkGray"
                                        android:textSize="@dimen/text_small" />

                                </RelativeLayout>

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_info_map_arrow_right" />
                            </LinearLayout>


                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/vertical_margin_half"
                                android:background="@color/LightGrey" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/vertical_margin_half"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/layoutPhone"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:paddingBottom="@dimen/horizontal_margin_third"
                                    android:paddingTop="@dimen/horizontal_margin_third">

                                    <ImageView
                                        android:id="@+id/imageView2"
                                        android:layout_width="20dp"
                                        android:layout_height="17dp"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="2dp"
                                        android:src="@drawable/ic_phone_blue" />

                                    <TextView
                                        android:id="@+id/txtWasherPhone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/horizontal_margin_third"
                                        android:text=""
                                        android:textColor="@color/Black"
                                        android:textColorLink="@color/White"
                                        android:textSize="@dimen/text_small" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:paddingBottom="@dimen/horizontal_margin_third"
                                    android:paddingTop="@dimen/horizontal_margin_third">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_marginLeft="2dp"
                                        android:layout_marginTop="2dp"
                                        android:src="@drawable/ic_comment_blue_24dp" />

                                    <TextView
                                        android:id="@+id/reviewCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                                        android:clickable="true"
                                        android:text="@string/reviews_count_example"
                                        android:textColor="@color/Black"
                                        android:textColorLink="@color/White"
                                        android:textSize="@dimen/text_small" />
                                </LinearLayout>

                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/vertical_margin_third"
                                android:background="@color/LightGrey" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/informationLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/horizontal_margin_third"
                                android:layout_marginRight="@dimen/horizontal_margin_half"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:paddingBottom="@dimen/horizontal_margin_third"
                                android:paddingTop="@dimen/horizontal_margin_third">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_gravity="center|top"
                                    android:src="@drawable/ic_info" />

                                <TextView
                                    android:id="@+id/reqireWashmeText"
                                    style="@style/EditText.Transparent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                                    android:maxLines="3"
                                    android:text="@string/wash_not_partner"
                                    android:textColor="@color/Black"
                                    android:textSize="@dimen/text_normal"
                                    android:textStyle="italic" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnRequireWashme"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:layout_gravity="center"
                                android:layout_marginBottom="@dimen/vertical_margin_half"
                                android:layout_marginLeft="@dimen/horizontal_margin_half"
                                android:layout_marginRight="@dimen/horizontal_margin_half"
                                android:layout_marginTop="@dimen/vertical_margin_half"
                                android:background="@drawable/background_blue_button"
                                android:padding="10dp"
                                android:text="@string/want_yes"
                                android:textAllCaps="false"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/mainFieldsLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/vertical_margin_half"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="-2dp"
                                    android:src="@drawable/ic_car_black" />

                                <com.driverspa.view.NDSpinner
                                    android:id="@+id/carSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center|left"
                                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                                    android:background="@drawable/spinner_bg"
                                    android:drawSelectorOnTop="true"
                                    android:popupBackground="@color/White"
                                    android:spinnerMode="dropdown"
                                    android:textColor="@color/Black"
                                    android:textCursorDrawable="@null"
                                    android:textSize="@dimen/text_small" />

                                <TextView
                                    android:id="@+id/myCarText"
                                    style="@style/EditText.Transparent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                                    android:layout_marginRight="@dimen/horizontal_margin_half"
                                    android:layout_weight="1"
                                    android:maxLines="2"
                                    android:text="@string/need_login_car_data"
                                    android:textColor="@color/Black"
                                    android:textSize="@dimen/text_normal"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginLeft="@dimen/horizontal_margin_double"
                                android:layout_marginRight="@dimen/horizontal_margin_half"
                                android:layout_marginTop="@dimen/vertical_margin_third"
                                android:background="@color/LightGrey" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/vertical_margin_half"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center|top"
                                    android:layout_marginTop="@dimen/vertical_margin_third"
                                    android:src="@drawable/ic_service_wash" />

                                <com.driverspa.view.NDSpinner
                                    android:id="@+id/serviceSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center|left"
                                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                                    android:background="@drawable/spinner_bg"
                                    android:drawSelectorOnTop="true"
                                    android:popupBackground="@color/White"
                                    android:spinnerMode="dropdown"
                                    android:textColor="@color/Black"
                                    android:textCursorDrawable="@null"
                                    android:textSize="@dimen/text_small" />

                                <LinearLayout
                                    android:id="@+id/bookService"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/background_list_item_white"
                                    android:orientation="horizontal"
                                    android:paddingBottom="@dimen/vertical_margin_half"
                                    android:paddingTop="@dimen/vertical_margin_half"
                                    android:visibility="gone">

                                    <TextView
                                        android:id="@+id/services"
                                        style="@style/EditText.Transparent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginRight="@dimen/horizontal_margin_half"
                                        android:layout_weight="1"
                                        android:text="@string/select_service"
                                        android:textColor="@color/Black"
                                        android:textSize="@dimen/text_normal" />

                                    <ImageView
                                        android:id="@+id/bookServiceClose"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:padding="@dimen/vertical_margin_third"
                                        android:src="@drawable/ic_close_black"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/bookServiceRightArrow"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:foregroundGravity="right"
                                        android:src="@drawable/ic_info_map_arrow_right" />

                                </LinearLayout>
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginLeft="@dimen/horizontal_margin_double"
                                android:layout_marginRight="@dimen/horizontal_margin_half"
                                android:background="@color/LightGrey" />

                            <LinearLayout
                                android:id="@+id/bookTimeLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/vertical_margin_half"
                                android:background="@drawable/background_list_item_white"
                                android:orientation="vertical"
                                android:paddingTop="@dimen/vertical_margin_half"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center|top"
                                        android:layout_marginTop="@dimen/vertical_margin_third"
                                        android:src="@drawable/ic_clock_selected" />

                                    <TextView
                                        android:id="@+id/bookTime"
                                        style="@style/EditText.Transparent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/horizontal_margin_third"
                                        android:layout_marginRight="@dimen/horizontal_margin_half"
                                        android:layout_weight="1"
                                        android:text="@string/choose_time"
                                        android:textColor="@color/Black"
                                        android:textSize="@dimen/text_normal" />

                                    <ImageView
                                        android:id="@+id/bookTimeClose"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:padding="@dimen/vertical_margin_third"
                                        android:src="@drawable/ic_close_black"
                                        android:visibility="gone" />


                                    <ImageView
                                        android:id="@+id/bookTimeRightArrow"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:foregroundGravity="right"
                                        android:src="@drawable/ic_info_map_arrow_right" />
                                </LinearLayout>

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginRight="@dimen/horizontal_margin_half"
                                    android:layout_marginTop="@dimen/vertical_margin_half"
                                    android:background="@color/LightGrey" />

                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/fareLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/vertical_margin_half"
                                android:layout_marginTop="@dimen/vertical_margin_half"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center|right"
                                    android:src="@drawable/ic_tenge_black" />

                                <EditText
                                    android:id="@+id/fare"
                                    style="@style/EditText.Transparent"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                                    android:hint="@string/offer_price"
                                    android:imeOptions="actionNext"
                                    android:inputType="number"
                                    android:lines="1"
                                    android:maxLength="10"
                                    android:maxLines="1"
                                    android:text=""
                                    android:textColor="@color/Black"
                                    android:textColorHint="@color/Gray"
                                    android:textCursorDrawable="@null"
                                    android:textIsSelectable="false"
                                    android:textSize="@dimen/text_normal" />
                            </LinearLayout>

                            <FrameLayout
                                android:id="@+id/fareLine"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginLeft="@dimen/horizontal_margin_double"
                                android:layout_marginRight="@dimen/horizontal_margin_half"
                                android:layout_marginTop="@dimen/vertical_margin_third"
                                android:background="@color/LightGrey" />

                            <LinearLayout
                                android:id="@+id/commentLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="13dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center|right"
                                    android:src="@drawable/ic_comment" />

                                <EditText
                                    android:id="@+id/comment"
                                    style="@style/EditText.Transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="3dp"
                                    android:layout_marginRight="@dimen/horizontal_margin_half"
                                    android:layout_weight="1"
                                    android:ems="10"
                                    android:hint="@string/comment"
                                    android:imeOptions="actionNext"
                                    android:inputType="textCapSentences|textMultiLine"
                                    android:lines="2"
                                    android:maxLength="70"
                                    android:maxLines="2"
                                    android:minLines="2"
                                    android:text=""
                                    android:textColor="@color/Black"
                                    android:textColorHint="@color/Gray"
                                    android:textCursorDrawable="@null"
                                    android:textIsSelectable="false"
                                    android:textSize="@dimen/text_normal" />
                            </LinearLayout>
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginLeft="@dimen/horizontal_margin_double"
                            android:layout_marginRight="@dimen/horizontal_margin_half"
                            android:layout_marginTop="@dimen/vertical_margin_third"
                            android:background="@color/LightGrey"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnRequest"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="@dimen/vertical_margin_half"
                            android:layout_marginLeft="@dimen/horizontal_margin_half"
                            android:layout_marginRight="@dimen/horizontal_margin_half"
                            android:layout_marginTop="@dimen/vertical_margin_half"
                            android:background="@drawable/background_blue_button"
                            android:padding="10dp"
                            android:text="@string/offer_your_price2"
                            android:textAllCaps="false"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_normal" />

                        <Button
                            android:id="@+id/btnMain"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="@dimen/vertical_margin_half"
                            android:layout_marginLeft="@dimen/horizontal_margin_half"
                            android:layout_marginRight="@dimen/horizontal_margin_half"
                            android:layout_marginTop="@dimen/vertical_margin_half"
                            android:background="@drawable/background_green_button"
                            android:padding="10dp"
                            android:text="@string/book_verb"
                            android:textAllCaps="false"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_normal"
