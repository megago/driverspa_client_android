<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginRight="@dimen/horizontal_margin_half"
            android:background="@drawable/rounded_rectangle_white"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <!-- ===== Header ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:text="@string/select_services"
                    android:textColor="@color/Black"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|right"
                    android:padding="@dimen/vertical_margin_half"
                    android:src="@drawable/ic_close_black" />
            </FrameLayout>

            <!-- ===== Services ===== -->
            <LinearLayout
                android:id="@+id/serviceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin_third"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/vertical_margin">

                    <TextView
                        android:id="@+id/selectedServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:layout_marginRight="@dimen/horizontal_margin_half"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="@string/selected_services"
                        android:textColor="@color/DarkGray"
                        android:visibility="gone"
                        android:textColorHint="@color/LightGrey"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:visibility="gone"
                        android:background="#ECEEF1"></FrameLayout>

                    <com.driverspa.view.ExpandableGridView
                        android:id="@+id/grid_group_services"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:horizontalSpacing="2dp"
                        android:isScrollContainer="false"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:layout_marginRight="@dimen/horizontal_margin_third"
                        android:listSelector="@android:color/transparent"
                        android:numColumns="auto_fit"
                        android:padding="1dp"
                        android:stretchMode="none"
                        android:verticalSpacing="5dp"
                        android:visibility="gone" />

                    <com.driverspa.view.ExpandableGridView
                        android:id="@+id/grid_services"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:layout_marginRight="@dimen/horizontal_margin_third"
                        android:adjustViewBounds="true"
                        android:horizontalSpacing="2dp"
                        android:isScrollContainer="false"
                        android:listSelector="@android:color/transparent"
                        android:numColumns="auto_fit"
                        android:padding="1dp"
                        android:stretchMode="none"
                        android:verticalSpacing="5dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/no_service"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:layout_marginRight="@dimen/horizontal_margin_half"
                        android:layout_marginTop="@dimen/vertical_margin_half"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="@string/no_available_services"
                        android:textColor="@color/DarkGray"
                        android:textColorHint="@color/LightGrey"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin_half"
                        android:background="#ECEEF1"
                        android:visibility="gone"></FrameLayout>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/vertical_margin_double"
                        android:background="@drawable/background_button_border"
                        android:paddingBottom="10dp"
                        android:paddingLeft="40dp"
                        android:paddingRight="40dp"
                        android:paddingTop="10dp"
                        android:text="@string/select_time"
                        android:textColor="@drawable/button_state_color"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Payment ===== -->
            <LinearLayout
                android:id="@+id/bottomLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/horizontal_margin"
                android:paddingRight="@dimen/horizontal_margin"
                android:paddingBottom="@dimen/vertical_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_payment_section"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/horizontal_margin_half"
                    android:paddingRight="@dimen/horizontal_margin_half">

                    <!-- Оплата header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_half"
                        android:paddingBottom="@dimen/vertical_margin_third">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_tenge_black" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/payment"
                            android:textColor="@color/Black"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#ECEEF1"></FrameLayout>

                    <!-- Cash -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_third">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_cash_colorful" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/in_cash"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <EditText
                            android:id="@+id/cashAmount"
                            style="@style/EditText.Transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:gravity="right"
                            android:hint="0"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:minWidth="48dp"
                            android:paddingBottom="@dimen/vertical_margin_third"
                            android:paddingTop="@dimen/vertical_margin_third"
                            android:singleLine="true"
                            android:text=""
                            android:textColor="@color/Black"
                            android:textColorHint="@color/DarkGray"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_medium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#ECEEF1"></FrameLayout>

                    <!-- Card -->
                    <LinearLayout
                        android:id="@+id/cardLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_third"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_card_colorful" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/by_card"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <EditText
                            android:id="@+id/cardAmount"
                            style="@style/EditText.Transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:gravity="right"
                            android:hint="0"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:minWidth="48dp"
                            android:paddingBottom="@dimen/vertical_margin_third"
                            android:paddingTop="@dimen/vertical_margin_third"
                            android:singleLine="true"
                            android:text=""
                            android:textColor="@color/Black"
                            android:textColorHint="@color/DarkGray"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_medium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/cardLayoutLine"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#ECEEF1"
                        android:visibility="gone"></FrameLayout>

                    <!-- Bonus -->
                    <LinearLayout
                        android:id="@+id/bonusLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_third"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_bonus_colorful" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/bonuses"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <EditText
                            android:id="@+id/bonusAmount"
                            style="@style/EditText.Transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:gravity="right"
                            android:hint="0"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:minWidth="48dp"
                            android:paddingBottom="@dimen/vertical_margin_third"
                            android:paddingTop="@dimen/vertical_margin_third"
                            android:singleLine="true"
                            android:text=""
                            android:textColor="@color/Black"
                            android:textColorHint="@color/DarkGray"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/clientBonusAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/of_zero_tenge"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_smaller" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/bonusLayoutLine"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#ECEEF1"
                        android:visibility="gone"></FrameLayout>

                    <!-- Deposit -->
                    <LinearLayout
                        android:id="@+id/depositLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_deposit_colorful" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/deposit"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <EditText
                            android:id="@+id/depositAmount"
                            style="@style/EditText.Transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:gravity="right"
                            android:hint="0"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:minWidth="48dp"
                            android:paddingBottom="@dimen/vertical_margin_third"
                            android:paddingTop="@dimen/vertical_margin_third"
                            android:singleLine="true"
                            android:text=""
                            android:textColor="@color/Black"
                            android:textColorHint="@color/DarkGray"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/clientDepositAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="@string/of_zero_tenge"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_smaller" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Summary ===== -->
                <LinearLayout
                    android:id="@+id/priceLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_third">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/time_word"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/txtTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero_min"
                            android:textColor="@color/Black"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_third">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_cost_plain"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/txtPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 ₸"
                            android:textColor="@color/Black"
                            android:textSize="@dimen/text_normal"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:paddingBottom="@dimen/vertical_margin_half">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/balance_word"
                            android:textColor="@color/DarkGray"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/txtPriceDifference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 ₸"
                            android:textColor="@color/Black"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnApply"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/vertical_margin_half"
                        android:background="@drawable/background_blue_button"
                        android:padding="10dp"
                        android:text="@string/apply"
                        android:textAllCaps="false"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
