<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingBottom="@dimen/vertical_margin">

    <FrameLayout
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Добавить машину"
            android:textColor="@color/White"
            android:textSize="@dimen/text_medium" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|right"
            android:padding="@dimen/vertical_margin"
            android:src="@drawable/ic_close_white_24dp" />
    </FrameLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vertical_margin">

            <HorizontalScrollView
                android:id="@+id/horizontalScrollView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/btnSedan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true">

                        <ImageView
                            android:id="@+id/imageView1"
                            android:layout_width="@dimen/book_cars_width"
                            android:layout_height="@dimen/book_cars_height"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/vertical_margin_five"
                            android:src="@drawable/background_button_sedan" />

                        <TextView
                            android:id="@+id/textView1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/imageView1"
                            android:layout_centerHorizontal="true"
                            android:gravity="center"
                            android:text="Седан"
                            android:textColor="@drawable/button_state_color_cars"
                            android:textSize="@dimen/text_smaller" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btnJeep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:clickable="true">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="@dimen/book_cars_width"
                            android:layout_height="@dimen/book_cars_height"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/vertical_margin_five"
                            android:src="@drawable/background_button_crossover" />

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/imageView2"
                            android:layout_centerHorizontal="true"
                            android:gravity="center"
                            android:text="Кроссовер"
                            android:textColor="@drawable/button_state_color_cars"
                            android:textSize="@dimen/text_smaller" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btnBigJeep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:clickable="true">

                        <ImageView
                            android:id="@+id/imageView4"
                            android:layout_width="@dimen/book_cars_width"
                            android:layout_height="@dimen/book_cars_height"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/vertical_margin_five"
                            android:src="@drawable/background_button_jeep" />

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/imageView4"
                            android:layout_centerHorizontal="true"
                            android:gravity="center"
                            android:text="Джип"
                            android:textColor="@drawable/button_state_color_cars"
                            android:textSize="@dimen/text_smaller" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btnMoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:clickable="true">

                        <ImageView
                            android:id="@+id/imageView33"
                            android:layout_width="45dp"
                            android:layout_height="@dimen/book_cars_height"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/vertical_margin_five"
                            android:src="@drawable/background_button_moto" />

                        <TextView
                            android:id="@+id/textView99"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/imageView33"
                            android:layout_centerHorizontal="true"
                            android:gravity="center"
                            android:text="Мотоцикл"
                            android:textColor="@drawable/button_state_color_cars"
                            android:textSize="@dimen/text_smaller" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btnMinbus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:clickable="true">

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="@dimen/book_cars_width"
                            android:layout_height="@dimen/book_cars_height"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/vertical_margin_five"
                            android:src="@drawable/background_button_minbus" />

                        <TextView
                            android:id="@+id/textView9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/imageView3"
                            android:layout_centerHorizontal="true"
                            android:gravity="center"
                            android:text="Микроавтобус"
                            android:textColor="@drawable/button_state_color_cars"
                            android:textSize="@dimen/text_smaller" />
                    </RelativeLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginTop="@dimen/vertical_margin"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:textColorHint="@color/BlueLight">
                    <EditText
                        android:id="@+id/carNo"
                        style="@style/EditText.Transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:hint="Гос. номер авто*"
                        android:imeOptions="actionNext"
                        android:inputType="textCapCharacters"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:maxLines="1"
                        android:maxLength="10"
                        android:lines="1"
                        android:textSize="@dimen/text_normal" />
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:textColorHint="@color/BlueLight">

                    <EditText
                        android:id="@+id/carMark"
                        style="@style/EditText.Transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:hint="Марка авто*"
                        android:imeOptions="actionNext"
                        android:textColor="@color/White"
                        android:maxLines="1"
                        android:maxLength="15"
                        android:lines="1"
                        android:inputType="textCapWords"
                        android:textColorHint="@color/BlueLight"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <Button
                    android:id="@+id/button_registration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vertical_margin_double"
                    android:background="@drawable/background_button_border"
                    android:padding="10dp"
                    android:text="Добавить"
                    android:textColor="@drawable/button_state_color"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>