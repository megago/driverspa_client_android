<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_list_item"
    android:clickable="true"
    android:paddingBottom="@dimen/vertical_margin_half"
    android:paddingTop="@dimen/vertical_margin_half">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtBookTime"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="10:30"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/txtBookTS"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="01.01.2016\n16:00"
                android:textColor="@color/Light"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutQueue"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/header_queue_height"
            android:orientation="vertical"
            android:paddingLeft="3dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_button_queue"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/order"
                    android:layout_width="@dimen/queue_height"
                    android:layout_height="@dimen/queue_height"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:minHeight="10dp"
                    android:minWidth="10dp"
                    android:paddingBottom="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="10dp"
                    android:text="123"
                    android:textColor="@drawable/button_state_color"
                    android:textSize="@dimen/text_normal"
                    android:textStyle="bold"
                    android:transitionName="title_transition" />
            </LinearLayout>

            <TextView
                android:id="@+id/queue_car_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:gravity="center"
                android:maxLength="10"
                android:maxLines="1"
                android:minHeight="10dp"
                android:minWidth="10dp"
                android:text="A001BBB"
                android:textColor="@color/White"
                android:textSize="@dimen/text_smallest" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtBookKey"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_gravity="left|center"
                android:gravity="center"

                android:text="Номер машины: x001xxx"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtBookStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Закончен"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_tag_item"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/txtBoxName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_weight="1"
                    android:background="@drawable/button_border_drawable_normal"
                    android:gravity="center"
                    android:text="Box 1"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_smaller" />
                <ImageView
                    android:id="@+id/notPaid"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:src="@drawable/ic_dollar_paid"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remainingTimeLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="0.4"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_weight="0"
                android:visibility="gone"
                android:src="@drawable/ic_flag_online_list" />

            <TextView
                android:id="@+id/remainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:text="00:00"
                android:textColor="@color/White"
                android:textSize="@dimen/text_medium" />

        </LinearLayout>

        <ImageView
            android:id="@+id/arrowRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/horizontal_margin_third"
            android:layout_marginRight="@dimen/horizontal_margin_third"
            android:src="@drawable/ic_arrow_right" />

    </LinearLayout>

</RelativeLayout>